{
  "name": "lcc-knowledge-base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "kb:server": "node apps/kb-server/src/server.js",
    "kb:web": "vite --config apps/kb-web/vite.config.ts --host 0.0.0.0",
    "kb:build": "vite build --config apps/kb-web/vite.config.ts",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint apps/kb-web apps/kb-server --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "vue": "^3.5.27"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.1.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "5.2.8",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.7"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
