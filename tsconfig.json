{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/kb-web/src/*"]
    }
  },
  "include": ["apps/kb-web/src/**/*.ts", "apps/kb-web/src/**/*.d.ts", "apps/kb-web/src/**/*.vue", "types/**/*.d.ts"],
  "references": []
}
