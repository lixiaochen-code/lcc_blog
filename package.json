  "scripts": {
    "kb:server": "node apps/kb-server/src/server.js",
    "kb:web": "vite --config apps/kb-web/vite.config.ts --host 0.0.0.0",
    "kb:dev": "node apps/kb-server/src/server.js",
    "dev:custom": "uni -p",
    "dev:h5": "uni",
    "dev:h5:ssr": "uni --ssr",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:mp-baidu": "uni -p mp-baidu",
